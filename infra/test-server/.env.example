# Copy to .env and adjust.
HTTP_PORT=8080
HTTPS_PORT=8443
SPEEDTEST_GARBAGE_MIB=100
# auto = HTTPS when certs/fullchain.pem + certs/privkey.pem exist; required; off
SPEEDTEST_HTTPS=auto
# off = no client IP logging (privacy by design)
SPEEDTEST_ACCESS_LOG=off

# FTP throughput server (spec v3 M14). Password: at least 12 characters, keep secret.
FTP_PORT=21
FTP_USER=onq
FTP_PASSWORD=
# Public IP/host for passive mode when the server is behind NAT (e.g. at PNG IX).
FTP_PUBLIC_ADDRESS=
FTP_UPLOAD_TTL_S=600
